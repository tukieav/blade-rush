{
  "name": "blade-rush",
  "version": "1.0.0",
  "description": "Blade Rush - neon knife-throw arcade game for CrazyGames",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --outfile=dist/bundle.js && node scripts/pack.mjs",
    "dev": "esbuild src/main.js --bundle --outfile=dist/bundle.js --watch --servedir=dist",
    "test": "node tests/e2e.mjs",
    "test:desktop": "node tools/e2e-desktop.cjs",
    "test:hardening": "node tools/e2e-hardening.cjs",
    "test:soak": "node tools/e2e-soak.cjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "playwright": "^1.62.1"
  }
}
